  {
    "name": "diamond",
    "sources": {
      "main.qnt": "module Main { import A from \"a\" import B from \"b\" }",
      "a.qnt": "module A { import C from \"c\" }",
      "b.qnt": "module B { import C from \"./c\" }",
      "c.qnt": "module C {}"
    },
    "reads": [
      "a.qnt",
