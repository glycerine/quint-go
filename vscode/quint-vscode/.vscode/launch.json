{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch Client (Go)",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/client/out/**/*.js"],
      "preLaunchTask": "build Go extension",
      "env": {
        "QUINT_VSCODE_SERVER_BACKEND": "go"
      }
    },
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch Client (TypeScript)",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/client/out/**/*.js"],
      "preLaunchTask": "build TypeScript extension",
      "env": {
        "QUINT_VSCODE_SERVER_BACKEND": "typescript"
      }
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to TypeScript Server",
      "port": 6009,
      "restart": true,
      "outFiles": ["${workspaceFolder}/server/out/**/*.js"]
    }
  ],
  "compounds": [
    {
      "name": "Client + TypeScript Server",
      "configurations": ["Launch Client (TypeScript)", "Attach to TypeScript Server"]
    }
  ]
}
